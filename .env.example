# 複製為 .env.local；不填密碼。所有 VITE_* 都會出現在瀏覽器。
VITE_EDITOR_EMAIL=
# 本機人工測試請啟用 Emulator，只會連到本機 demo 專案。
VITE_USE_FIREBASE_EMULATORS=true
# 正式環境關閉 Emulator；可沿用既有公開 Firebase Web 設定。
# 此分支停用自動部署；未來 Preview 須完整提供隔離專案的以下五項設定。
# 本輪只使用本機模擬，不需要建立雲端測試專案。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
